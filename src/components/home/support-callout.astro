---
import { ArrowUpRight } from "lucide-react";
import { supportCallout } from "../../data/site-content";
---

<section class="mx-auto max-w-7xl px-4 pb-8 sm:px-6 lg:px-8">
  <div
    class="grid grid-cols-1 items-center gap-8 rounded-[2rem] border border-black/[0.06] bg-white p-8 md:grid-cols-12 md:p-12"
  >
    <div class="md:col-span-7">
      <p class="text-ink-mute mb-4 text-[0.72rem] tracking-[0.22em] uppercase">
        Nous soutenir
      </p>
      <h2
        class="tracking-headline balance text-ink text-[1.6rem] leading-[1.08] font-semibold sm:text-3xl md:text-[2.5rem]"
      >
        {supportCallout.title}
      </h2>
      <p class="text-ink-mute mt-4 max-w-xl text-[0.98rem] leading-relaxed">
        {supportCallout.text}
      </p>
    </div>
    <div class="flex flex-col gap-3 md:col-span-5 md:items-end">
      <a
        href="/soutenir"
        class="group bg-ink hover:bg-ink-soft inline-flex min-h-13 items-center justify-center gap-2 rounded-full px-7 text-[0.95rem] font-medium text-white transition-all active:scale-[0.98]"
        >Soutenir l'ISAJ <ArrowUpRight
          size={16}
          className="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
        /></a
      >
      <a
        href="/partnership"
        class="text-ink inline-flex min-h-13 items-center justify-center gap-2 rounded-full border border-black/[0.1] px-6 text-[0.95rem] font-medium transition-colors hover:bg-black/[0.03]"
        >Devenir partenaire</a
      >
    </div>
  </div>
</section>
