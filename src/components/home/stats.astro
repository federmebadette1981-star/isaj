---
import { keyFigures } from "../../data/site-content";
---

<section
  class="relative z-20 mx-auto -mt-2 mb-4 max-w-6xl px-4 sm:px-6 lg:px-8"
>
  <div
    class="grain bg-ink shadow-ink-lg relative overflow-hidden rounded-[2.25rem] p-7 text-white sm:p-8 md:rounded-[2.5rem] md:p-10"
  >
    <dl class="relative grid grid-cols-1 gap-y-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-y-0">
      {
        keyFigures.map((figure, index) => (
          <div
            class={`relative px-0 sm:px-4 ${index > 0 ? "lg:border-l lg:border-white/8" : ""}`}
          >
            <dt
              class={`flex items-end leading-tight font-semibold tracking-[-0.03em] text-white lg:min-h-[4.25rem] ${
                figure.value.length > 14
                  ? "text-[1.05rem] sm:text-[1.15rem] md:text-[1.25rem]"
                  : "text-[1.5rem] sm:text-[1.8rem] md:text-[2.1rem]"
              }`}
            >
              {figure.value}
            </dt>
            <dd class="mt-3 max-w-[24ch] text-[0.78rem] leading-snug text-white/55">
              {figure.label}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
