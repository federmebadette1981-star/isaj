---
import { Image } from "astro:assets";
import { ArrowUpRight } from "lucide-react";
import { photos } from "../../data/photos";
import { institutionalFacts, schoolIdentity } from "../../data/site-content";

/** Un groupe par section : préscolaire, fondamental, secondaire. */
const showcase = [
  photos.prescolaireGroupe,
  photos.fondamentalGroupe,
  photos.secondaireLigne,
];
---

<section
  class="relative mx-auto max-w-7xl px-4 pt-8 pb-16 sm:px-6 sm:pb-24 lg:px-8 lg:pt-16 lg:pb-32"
>
  <div class="mb-8 flex justify-center sm:mb-10">
    <span
      class="text-ink-soft inline-flex items-center gap-2 rounded-full border border-black/8 bg-white/60 px-3 py-1.5 text-center text-[0.78rem] font-medium backdrop-blur-md"
    >
      <span class="bg-brand inline-flex h-1.5 w-1.5 shrink-0 rounded-full"
      ></span>
      {schoolIdentity.name} ({schoolIdentity.shortName})
    </span>
  </div>

  <div class="relative mx-auto max-w-5xl text-center">
    <h1
      class="tracking-headline balance text-ink text-[2.4rem] leading-[1.04] font-semibold sm:text-6xl md:text-[5.25rem] md:leading-[0.98]"
    >
      Éduquer aujourd'hui,
      <br class="hidden sm:block" />
      <span class="font-display text-brand-deep font-normal italic"
        >construire l'avenir.</span
      >
    </h1>

    <p
      class="pretty text-ink-mute mx-auto mt-6 max-w-xl text-[0.98rem] leading-relaxed sm:mt-7 md:text-[1.05rem]"
    >
      {institutionalFacts.heroIntro}
    </p>

    <div
      class="mt-8 flex flex-col items-stretch justify-center gap-2.5 sm:mt-9 sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-3 sm:gap-y-2"
    >
      <a
        href="/about"
        class="group bg-ink hover:bg-ink-soft inline-flex min-h-12 items-center justify-center gap-2 rounded-full px-6 text-[0.95rem] font-medium text-white transition-all active:scale-[0.98]"
      >
        Découvrir l'ISAJ
        <ArrowUpRight
          size={17}
          className="transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
        />
      </a>
      <a
        href="/contact"
        class="group text-ink inline-flex min-h-12 items-center justify-center gap-2 rounded-full border border-black/[0.1] bg-white/70 px-6 text-[0.95rem] font-medium backdrop-blur-md transition-colors hover:bg-white"
      >
        Nous contacter
      </a>
      <a
        href="/partnership"
        class="group text-ink decoration-ink/20 hover:decoration-ink/60 inline-flex min-h-12 items-center justify-center gap-2 rounded-full px-5 text-[0.95rem] font-medium underline decoration-1 underline-offset-[6px] transition-colors"
      >
        Devenir partenaire
      </a>
    </div>
  </div>

  <div class="relative mt-16 hidden md:block lg:mt-20">
    <div class="grid grid-cols-12 items-end gap-6">
      <figure class="col-span-4">
        <Image
          src={showcase[0].image}
          alt={showcase[0].alt}
          widths={[400, 800]}
          sizes="(min-width: 768px) 33vw, 100vw"
          class="shadow-ink-lg aspect-[4/5] w-full rounded-[2rem] object-cover"
        />
      </figure>
      <figure class="col-span-4 -mb-12 translate-y-6">
        <Image
          src={showcase[1].image}
          alt={showcase[1].alt}
          widths={[400, 800]}
          sizes="(min-width: 768px) 33vw, 100vw"
          class="shadow-ink-lg aspect-[3/4] w-full rounded-[2rem] object-cover"
        />
      </figure>
      <figure class="col-span-4">
        <Image
          src={showcase[2].image}
          alt={showcase[2].alt}
          widths={[400, 800]}
          sizes="(min-width: 768px) 33vw, 100vw"
          class="shadow-ink-lg aspect-[5/6] w-full rounded-[2rem] object-cover"
        />
      </figure>
    </div>
  </div>

  <div class="relative mt-10 md:hidden">
    <Image
      src={showcase[0].image}
      alt={showcase[0].alt}
      widths={[400, 800]}
      sizes="100vw"
      class="shadow-ink-lg aspect-[4/5] w-full rounded-[2rem] object-cover"
    />
  </div>
</section>
