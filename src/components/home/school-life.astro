---
import { Image } from "astro:assets";
import { ArrowUpRight } from "lucide-react";
import { photos } from "../../data/photos";

/**
 * « La vie à l'ISAJ » — ce que les élèves vivent chaque jour, au-delà des cours :
 * le rassemblement du matin, la levée du drapeau, la fanfare et la récréation.
 */
const moments = [
  {
    ...photos.drapeau,
    label: "Civisme",
    text: "Chaque semaine, les élèves hissent le drapeau haïtien dans la cour de l'école.",
  },
  {
    ...photos.rassemblement,
    label: "Discipline",
    text: "La journée commence par un rassemblement de tout l'établissement.",
  },
  {
    ...photos.fanfare,
    label: "Musique",
    text: "La fanfare accompagne les rassemblements et les cérémonies de l'école.",
  },
  {
    ...photos.recreation,
    label: "Vie scolaire",
    text: "La récréation, les jeux et les moments partagés entre les cours.",
  },
];
---

<section class="bg-white py-24 lg:py-32">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div
      class="mb-14 flex flex-col items-start justify-between gap-6 lg:flex-row lg:items-end"
    >
      <div class="max-w-2xl">
        <p
          class="text-ink-mute mb-4 text-[0.72rem] tracking-[0.22em] uppercase"
        >
          La vie à l'ISAJ
        </p>
        <h2
          class="tracking-headline balance text-ink text-[1.75rem] leading-[1.05] font-semibold sm:text-4xl md:text-[3.25rem]"
        >
          Apprendre, et <span
            class="font-display text-brand-deep font-normal italic"
            >grandir ensemble.</span
          >
        </h2>
      </div>
      <p class="pretty text-ink-mute max-w-sm text-[0.95rem] leading-relaxed">
        Au-delà des cours, l'ISAJ développe la discipline, le civisme et le goût
        de l'effort à travers la vie quotidienne de l'établissement.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-5 md:grid-cols-3 lg:gap-6">
      {
        moments.map((moment, index) => (
          <figure
            class={`group relative overflow-hidden rounded-[1.75rem] ${
              index === 0 ? "md:col-span-3" : ""
            }`}
          >
            <Image
              src={moment.image}
              alt={moment.alt}
              widths={[400, 800, 1200]}
              sizes={index === 0 ? "100vw" : "(min-width: 768px) 33vw, 100vw"}
              loading="lazy"
              class={`w-full object-cover transition-transform duration-[1200ms] ease-out group-hover:scale-105 ${
                index === 0
                  ? "h-72 sm:h-96 md:h-[30rem]"
                  : "h-64 sm:h-80 md:h-[20rem]"
              }`}
            />
            <div class="from-ink/90 via-ink/25 absolute inset-0 bg-gradient-to-t to-transparent" />
            <figcaption class="absolute inset-x-0 bottom-0 p-6 md:p-8">
              <span class="inline-block rounded-full bg-white/15 px-2.5 py-0.5 text-[0.7rem] font-medium tracking-[0.18em] text-white/85 uppercase backdrop-blur">
                {moment.label}
              </span>
              <h3 class="font-display mt-3 text-[1.4rem] leading-tight font-medium text-white md:text-[1.9rem]">
                {moment.title}
              </h3>
              <p class="mt-2 max-w-md text-[0.9rem] leading-relaxed text-white/75">
                {moment.text}
              </p>
            </figcaption>
          </figure>
        ))
      }
    </div>

    <div class="mt-10">
      <a
        href="/gallery"
        class="group text-ink decoration-ink/20 hover:decoration-ink inline-flex min-h-11 items-center gap-2 text-[0.9rem] font-medium underline decoration-1 underline-offset-[6px] transition-colors"
        >Voir toute la galerie <ArrowUpRight
          size={15}
          className="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
        /></a
      >
    </div>
  </div>
</section>
