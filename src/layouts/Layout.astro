---
import "../styles/global.css";
import Footer from "./Footer.astro";
import Navbar from "./navbar";
import { officialEmail, schoolIdentity, contactDetails } from "../data/site-content";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Institution Le Saint Justien (ISAJ) | École à Bon-Repos, Haïti",
  description = "Institution Le Saint Justien est un établissement scolaire situé à Bon-Repos, Croix-des-Bouquets, Haïti, offrant un enseignement du préscolaire au secondaire.",
  image = "/isaj-64.jpeg",
} = Astro.props;

const siteUrl = Astro.site ?? new URL("https://isaj.vercel.app");
const canonical = new URL(Astro.url.pathname, siteUrl);
const socialImage = new URL(image, siteUrl);

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "School",
  name: schoolIdentity.name,
  alternateName: schoolIdentity.shortName,
  description,
  url: siteUrl.href,
  email: officialEmail,
  telephone: contactDetails.phones.map((phone) => phone.display),
  foundingDate: "2011-09",
  address: {
    "@type": "PostalAddress",
    streetAddress: "5, Impasse Bernard, Route Nationale #1",
    addressLocality: "Bon-Repos, Croix-des-Bouquets",
    addressCountry: "HT",
  },
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#edf2ff" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="mask-icon" href="/favicon.svg" color="#2657ee" />

    <!-- Aperçu des liens (WhatsApp, Facebook, LinkedIn, messageries) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={schoolIdentity.name} />
    <meta property="og:locale" content="fr_HT" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={socialImage.href} />
    <meta property="og:image:width" content="1040" />
    <meta property="og:image:height" content="780" />
    <meta
      property="og:image:alt"
      content="Entrée de l'Institution Le Saint Justien (ISAJ), Bon-Repos, Haïti"
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage.href} />

    <meta name="robots" content="index, follow" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(organizationSchema)}
    />
  </head>
  <body class="antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-full focus:bg-[var(--color-ink)] focus:px-4 focus:py-2 focus:text-sm focus:text-white"
      >Aller au contenu</a
    >
    <div
      class="relative min-h-screen overflow-hidden bg-[var(--color-paper)] text-[var(--color-ink)] selection:bg-[var(--color-brand)] selection:text-white"
    >
      <div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10">
        <div
          class="absolute top-[-10%] left-[-5%] h-[60vh] w-[60vh] rounded-full bg-[#b8cfff] opacity-55 blur-[120px]"
        >
        </div>
        <div
          class="absolute right-[-10%] bottom-[-10%] h-[55vh] w-[55vh] rounded-full bg-[#7ba8ff] opacity-35 blur-[120px]"
        >
        </div>
      </div>

      <Navbar client:load />
      <main id="main">
        <slot />
      </main>
      <Footer />
    </div>

    <style is:global>
      html,
      body {
        margin: 0;
        width: 100%;
        overflow-x: hidden;
      }
      body {
        min-height: 100dvh;
      }
    </style>
  </body>
</html>
