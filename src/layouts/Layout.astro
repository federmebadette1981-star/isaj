---
import "../styles/global.css";
import Footer from "./Footer.astro";
import Navbar from "./navbar";
import {
  officialEmail,
  schoolIdentity,
  contactDetails,
} from "../data/site-content";

type Breadcrumb = { name: string; path: string };

interface Props {
  /** Titre complet de l'onglet et des résultats Google (idéalement ≤ 60 caractères). */
  title?: string;
  /** Extrait affiché sous le titre dans Google (idéalement 120 à 160 caractères). */
  description?: string;
  image?: string;
  imageAlt?: string;
  /** Mots-clés propres à la page, ajoutés aux mots-clés communs. */
  keywords?: string[];
  /** Fil d'Ariane (hors accueil) — génère le balisage BreadcrumbList. */
  breadcrumbs?: Breadcrumb[];
  noindex?: boolean;
}

const {
  title = "Institution Le Saint Justien (ISAJ) | École privée en Haïti",
  description = "École privée à Bon-Repos, Croix-des-Bouquets (Haïti) depuis 2011 : préscolaire, fondamental et secondaire pour environ 250 élèves. Préinscription en ligne.",
  image = "/og-isaj.jpg",
  imageAlt = "Entrée de l'Institution Le Saint Justien (ISAJ), Bon-Repos, Haïti",
  keywords = [],
  breadcrumbs = [],
  noindex = false,
} = Astro.props;

const baseKeywords = [
  "Institution Le Saint Justien",
  "ISAJ",
  "école Bon-Repos",
  "école Croix-des-Bouquets",
  "école privée Haïti",
];
const allKeywords = [...new Set([...keywords, ...baseKeywords])].join(", ");

const siteUrl = Astro.site ?? new URL("https://isajhaiti.org");
// Cloudflare Pages sert /about et redirige /about/ vers /about : l'URL
// canonique doit être la forme finale, sans barre oblique (sauf l'accueil).
const pathname =
  Astro.url.pathname.length > 1 ? Astro.url.pathname.replace(/\/+$/, "") : "/";
const canonical = new URL(pathname, siteUrl);
const socialImage = new URL(image, siteUrl);
const schoolId = new URL("/#ecole", siteUrl).href;

const graph: Record<string, unknown>[] = [
  {
    "@type": ["School", "EducationalOrganization"],
    "@id": schoolId,
    name: schoolIdentity.name,
    alternateName: schoolIdentity.shortName,
    description:
      "Établissement scolaire privé à Bon-Repos, Croix-des-Bouquets, Haïti, ouvert en septembre 2011 : section préscolaire, section fondamentale et section secondaire.",
    slogan: schoolIdentity.tagline,
    url: siteUrl.href,
    image: new URL("/og-isaj.jpg", siteUrl).href,
    email: officialEmail,
    telephone: contactDetails.phones[0].display,
    contactPoint: contactDetails.phones.map((phone) => ({
      "@type": "ContactPoint",
      telephone: phone.display,
      contactType: "secrétariat",
      availableLanguage: "fr",
    })),
    foundingDate: "2011-09",
    founder: [
      {
        "@type": "Person",
        name: "Osnel Saint-Juste",
        jobTitle: "Directeur Fondateur",
      },
      { "@type": "Person", name: "Federme Badette", jobTitle: "Cofondateur" },
    ],
    address: {
      "@type": "PostalAddress",
      streetAddress: "5, Impasse Bernard, Route Nationale #1",
      addressLocality: "Bon-Repos, Croix-des-Bouquets",
      addressRegion: "Ouest",
      addressCountry: "HT",
    },
    hasMap: schoolIdentity.mapsUrl,
    areaServed: { "@type": "Place", name: "Croix-des-Bouquets, Haïti" },
  },
  {
    "@type": "WebSite",
    "@id": new URL("/#site", siteUrl).href,
    name: schoolIdentity.name,
    alternateName: schoolIdentity.shortName,
    url: siteUrl.href,
    inLanguage: "fr",
    publisher: { "@id": schoolId },
  },
];

if (breadcrumbs.length > 0) {
  graph.push({
    "@type": "BreadcrumbList",
    itemListElement: [{ name: "Accueil", path: "/" }, ...breadcrumbs].map(
      (crumb, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: crumb.name,
        item: new URL(crumb.path, siteUrl).href,
      }),
    ),
  });
}

const structuredData = { "@context": "https://schema.org", "@graph": graph };
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#edf2ff" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={allKeywords} />
    <link rel="canonical" href={canonical.href} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="mask-icon" href="/favicon.svg" color="#2657ee" />

    <!-- Aperçu des liens (WhatsApp, Facebook, LinkedIn, messageries) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={schoolIdentity.name} />
    <meta property="og:locale" content="fr_HT" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={socialImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage.href} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <meta
      name="robots"
      content={noindex
        ? "noindex, follow"
        : "index, follow, max-image-preview:large, max-snippet:-1"}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
  </head>
  <body class="antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-full focus:bg-[var(--color-ink)] focus:px-4 focus:py-2 focus:text-sm focus:text-white"
      >Aller au contenu</a
    >
    <div
      class="relative min-h-screen overflow-hidden bg-[var(--color-paper)] text-[var(--color-ink)] selection:bg-[var(--color-brand)] selection:text-white"
    >
      <div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10">
        <div
          class="absolute top-[-10%] left-[-5%] h-[60vh] w-[60vh] rounded-full bg-[#b8cfff] opacity-55 blur-[120px]"
        >
        </div>
        <div
          class="absolute right-[-10%] bottom-[-10%] h-[55vh] w-[55vh] rounded-full bg-[#7ba8ff] opacity-35 blur-[120px]"
        >
        </div>
      </div>

      <Navbar client:load />
      <main id="main">
        <slot />
      </main>
      <Footer />
    </div>

    <style is:global>
      html,
      body {
        margin: 0;
        width: 100%;
        overflow-x: hidden;
      }
      body {
        min-height: 100dvh;
      }
    </style>
  </body>
</html>
