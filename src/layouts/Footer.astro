---
import { ArrowUpRight, Mail, MapPin, Phone } from "lucide-react";
import { contactDetails, schoolIdentity } from "../data/site-content";

const quickLinks = [
  { href: "/", label: "Accueil" },
  { href: "/about", label: "À propos" },
  { href: "/curriculum", label: "Programme" },
  { href: "/teams", label: "Notre équipe" },
  { href: "/gallery", label: "Galerie" },
  { href: "/enrollment", label: "Admissions" },
  { href: "/partnership", label: "Partenariat" },
  { href: "/contact", label: "Contact" },
];
---

<footer
  class="bg-ink relative mt-12 overflow-hidden rounded-t-[2.5rem] text-white"
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-40 left-1/2 h-[40rem] w-[40rem] -translate-x-1/2 rounded-full"
    style="background: radial-gradient(circle, rgba(38,87,238,0.18) 0%, transparent 60%)"
  >
  </div>
  <div class="relative mx-auto max-w-7xl px-6 pt-20 pb-10 lg:px-8 lg:pt-24">
    <div
      class="mb-16 grid grid-cols-1 items-end gap-10 lg:grid-cols-12 lg:gap-16"
    >
      <div class="lg:col-span-7">
        <p class="text-[0.72rem] tracking-[0.22em] text-white/40 uppercase">
          {schoolIdentity.name} ({schoolIdentity.shortName})
        </p>
        <h2
          class="font-display tracking-headline mt-3 text-[2.25rem] leading-[1.0] font-medium text-white sm:text-5xl md:text-7xl"
        >
          Éduquer aujourd'hui, <span class="text-white/65 italic"
            >construire l'avenir.</span
          >
        </h2>
        <p class="mt-5 text-[0.85rem] tracking-[0.16em] text-white/45 uppercase">
          {schoolIdentity.signature}
        </p>
      </div>
      <div class="lg:col-span-5">
        <p class="max-w-md text-[0.95rem] leading-relaxed text-white/55">
          Former des élèves responsables, compétents et engagés dans leur
          communauté, du préscolaire au secondaire, à Bon-Repos.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href="/enrollment"
            class="group text-ink inline-flex min-h-11 items-center gap-2 rounded-full bg-white px-5 text-[0.88rem] font-medium transition-all hover:bg-white/90"
            >Demande de préinscription <ArrowUpRight size={15} /></a
          >
          <a
            href="/partnership"
            class="inline-flex min-h-11 items-center gap-2 rounded-full border border-white/20 px-5 text-[0.88rem] font-medium text-white transition-colors hover:bg-white/5"
            >Devenir partenaire</a
          >
        </div>
      </div>
    </div>

    <div
      class="grid grid-cols-1 gap-10 border-t border-white/10 pt-12 sm:grid-cols-2 lg:grid-cols-12"
    >
      <div class="lg:col-span-3">
        <p class="mb-4 text-[0.72rem] tracking-[0.18em] text-white/40 uppercase">
          Adresse
        </p>
        <div class="flex items-start gap-2 text-[0.92rem] text-white/75">
          <MapPin
            size={14}
            className="mt-1 shrink-0 text-white/40"
            strokeWidth={1.6}
          />
          <address class="space-y-0.5 not-italic">
            {schoolIdentity.addressLines.map((line) => <p>{line}</p>)}
          </address>
        </div>
        <a
          href={schoolIdentity.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-flex items-center gap-2 text-[0.88rem] font-medium text-white/80 underline underline-offset-4 transition-colors hover:text-white"
          >Voir notre localisation <ArrowUpRight size={14} /></a
        >
      </div>

      <div class="lg:col-span-4">
        <p class="mb-4 text-[0.72rem] tracking-[0.18em] text-white/40 uppercase">
          Téléphone
        </p>
        <ul class="space-y-1">
          {
            contactDetails.phones.map((phone) => (
              <li>
                <a
                  href={phone.href}
                  class="flex min-h-11 items-center gap-2 text-[0.95rem] text-white/75 transition-colors hover:text-white"
                >
                  <Phone
                    size={14}
                    className="shrink-0 text-white/40"
                    strokeWidth={1.6}
                  />
                  {phone.display}
                </a>
              </li>
            ))
          }
        </ul>
        <p class="mt-4 mb-2 text-[0.72rem] tracking-[0.18em] text-white/40 uppercase">
          Email
        </p>
        <a
          href={`mailto:${contactDetails.email}`}
          class="flex items-start gap-2 text-[0.92rem] break-all text-white/75 transition-colors hover:text-white"
        >
          <Mail
            size={14}
            className="mt-1 shrink-0 text-white/40"
            strokeWidth={1.6}
          />
          {contactDetails.email}
        </a>
      </div>

      <div class="sm:col-span-2 lg:col-span-5">
        <p class="mb-4 text-[0.72rem] tracking-[0.18em] text-white/40 uppercase">
          Liens rapides
        </p>
        <ul class="grid grid-cols-2 gap-x-6 text-[0.92rem]">
          {
            quickLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="flex min-h-10 items-center text-white/75 transition-colors hover:text-white"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div
      class="mt-16 flex flex-col items-start justify-between gap-4 border-t border-white/10 pt-6 text-[0.78rem] text-white/40 md:flex-row md:items-center"
    >
      <a
        href="/confidentialite"
        class="transition-colors hover:text-white/70">Politique de confidentialité</a
      >
      <span
        >© 2026 {schoolIdentity.name} ({schoolIdentity.shortName}). Tous droits
        réservés.</span
      >
    </div>
  </div>
</footer>
