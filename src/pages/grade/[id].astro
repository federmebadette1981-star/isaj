---
import {
  ArrowLeft,
  ArrowRight,
  ArrowUpRight,
  BookOpen,
  Check,
  Compass,
  Mail,
  MapPin,
  Phone,
  Target,
} from "lucide-react";
import { gradeProfiles } from "../../data/grade-profiles";
import {
  admissionNote,
  contactDetails,
  schoolIdentity,
} from "../../data/site-content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  return gradeProfiles.map((grade) => ({
    params: { id: grade.id },
    props: { grade },
  }));
}

const { grade } = Astro.props as { grade: (typeof gradeProfiles)[number] };

const gradeIndex = gradeProfiles.findIndex(({ id }) => id === grade.id);
const total = String(gradeProfiles.length).padStart(2, "0");
const stageNumber = String(gradeIndex + 1).padStart(2, "0");
const previousGrade = gradeProfiles[gradeIndex - 1] ?? null;
const nextGrade = gradeProfiles[gradeIndex + 1] ?? null;
---

<Layout
  title={`${grade.title} — ${schoolIdentity.name} (ISAJ)`}
  description={grade.overview}
>
  <section
    class="mx-auto max-w-7xl px-4 pt-12 pb-16 sm:px-6 lg:px-8 lg:pt-16"
  >
    <a
      href="/curriculum"
      class="group text-ink-mute hover:text-ink inline-flex items-center gap-2 text-[0.85rem] transition-colors"
    >
      <ArrowLeft
        size={15}
        className="transition-transform group-hover:-translate-x-0.5"
      />
      Retour au programme
    </a>

    <div
      class="mt-10 grid grid-cols-1 items-end gap-10 lg:grid-cols-12 lg:gap-16"
    >
      <div class="lg:col-span-8">
        <p
          class="tabular text-ink-mute mb-4 text-[0.72rem] tracking-[0.22em] uppercase"
        >
          Section {stageNumber} / {total} · {grade.grades}
        </p>
        <h1
          class="tracking-headline balance text-ink text-[2rem] leading-[1.02] font-semibold sm:text-5xl md:text-[4.5rem]"
        >
          {grade.title}
        </h1>
        <p
          class="font-display text-ink-soft mt-5 text-[1.25rem] leading-snug italic md:text-[1.5rem]"
        >
          {grade.subtitle}.
        </p>
      </div>
      <p
        class="pretty text-ink-mute max-w-md text-[1rem] leading-relaxed lg:col-span-4"
      >
        {grade.overview}
      </p>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <BookOpen size={22} className="text-brand" />
          <p
            class="text-ink-mute mt-6 mb-4 text-[0.72rem] tracking-[0.22em] uppercase"
          >
            Classes concernées
          </p>
          <h2
            class="tracking-headline text-ink text-[1.6rem] leading-[1.08] font-semibold sm:text-3xl md:text-[2.5rem]"
          >
            Le parcours de cette section.
          </h2>
        </div>
        <ul class="space-y-3 lg:col-span-7">
          {
            grade.classes.map((item, index) => (
              <li class="flex items-start gap-4 rounded-2xl border border-black/[0.06] p-5">
                <span class="tabular text-brand-deep text-[0.72rem]">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="text-ink text-[0.98rem] leading-relaxed">
                  {item}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <Target size={22} className="text-brand" />
        <h2
          class="tracking-headline text-ink mt-6 text-[1.5rem] leading-[1.08] font-semibold sm:text-[1.9rem]"
        >
          Objectifs pédagogiques
        </h2>
        <ul class="mt-8 space-y-4">
          {
            grade.objectives.map((item) => (
              <li class="text-ink-soft flex items-start gap-3 text-[0.95rem] leading-relaxed">
                <Check
                  size={16}
                  strokeWidth={2}
                  className="text-brand mt-1 shrink-0"
                />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <Compass size={22} className="text-brand" />
        <h2
          class="tracking-headline text-ink mt-6 text-[1.5rem] leading-[1.08] font-semibold sm:text-[1.9rem]"
        >
          Principales matières
        </h2>
        <ul class="mt-8 flex flex-wrap gap-2">
          {
            grade.subjects.map((item) => (
              <li class="text-ink rounded-full border border-black/[0.08] bg-white px-4 py-2 text-[0.88rem]">
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
      <div class="mb-12 max-w-2xl">
        <p
          class="text-ink-mute mb-4 text-[0.72rem] tracking-[0.22em] uppercase"
        >
          Approche pédagogique
        </p>
        <h2
          class="tracking-headline text-ink text-[1.75rem] leading-[1.05] font-semibold sm:text-4xl md:text-[3rem]"
        >
          Comment nous <span
            class="font-display text-brand-deep font-normal italic"
            >travaillons.</span
          >
        </h2>
      </div>
      <div
        class="grid grid-cols-1 gap-px overflow-hidden rounded-[1.5rem] bg-black/[0.06] md:grid-cols-3"
      >
        {
          grade.approach.map((item, index) => (
            <article class="bg-[var(--color-paper)] p-7 lg:p-9">
              <span class="tabular text-ink-mute text-[0.72rem] tracking-[0.18em] uppercase">
                {String(index + 1).padStart(2, "0")}
              </span>
              <h3 class="font-display text-ink mt-8 text-[1.25rem] leading-tight font-medium">
                {item.label}
              </h3>
              <p class="text-ink-mute mt-3 text-[0.92rem] leading-relaxed">
                {item.text}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-12 lg:gap-8">
      <div
        class="rounded-[2rem] border border-black/[0.06] bg-white p-8 md:p-12 lg:col-span-7"
      >
        <p class="text-ink-mute text-[0.72rem] tracking-[0.22em] uppercase">
          Admissions
        </p>
        <h2
          class="tracking-headline text-ink mt-5 text-[1.6rem] leading-[1.08] font-semibold md:text-[2.25rem]"
        >
          Rejoindre cette section.
        </h2>
        <p class="text-ink-mute mt-5 max-w-xl text-[0.98rem] leading-relaxed">
          {grade.admissions}
        </p>
        <p class="text-ink-mute mt-4 max-w-xl text-[0.92rem] leading-relaxed">
          {admissionNote}
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a
            href="/enrollment"
            class="group bg-ink hover:bg-ink-soft inline-flex min-h-12 items-center justify-center gap-2 rounded-full px-6 text-[0.92rem] font-medium text-white transition-all active:scale-[0.98]"
            >Demande de préinscription <ArrowUpRight size={15} /></a
          >
          <a
            href="/curriculum"
            class="text-ink inline-flex min-h-12 items-center justify-center gap-2 rounded-full border border-black/[0.08] px-6 text-[0.92rem] font-medium transition-colors hover:bg-black/[0.03]"
            >Voir tout le programme</a
          >
        </div>
      </div>

      <div
        class="grain bg-ink relative overflow-hidden rounded-[2rem] p-8 text-white md:p-10 lg:col-span-5"
      >
        <p class="text-[0.72rem] tracking-[0.22em] text-white/45 uppercase">
          Contact
        </p>
        <h2 class="font-display mt-4 text-[1.6rem] leading-tight italic">
          Parler au secrétariat
        </h2>
        <ul class="mt-8 space-y-4 text-[0.92rem]">
          {
            contactDetails.phones.map((phone) => (
              <li>
                <a
                  href={phone.href}
                  class="flex min-h-11 items-center gap-3 text-white/80 transition-colors hover:text-white"
                >
                  <Phone size={15} strokeWidth={1.6} className="shrink-0 text-white/40" />
                  {phone.display}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href={`mailto:${contactDetails.email}`}
              class="flex items-start gap-3 break-all text-white/80 transition-colors hover:text-white"
            >
              <Mail
                size={15}
                strokeWidth={1.6}
                className="mt-1 shrink-0 text-white/40"
              />
              {contactDetails.email}
            </a>
          </li>
          <li class="flex items-start gap-3 text-white/60">
            <MapPin
              size={15}
              strokeWidth={1.6}
              className="mt-1 shrink-0 text-white/40"
            />
            <span>{schoolIdentity.address}</span>
          </li>
        </ul>
        <a
          href="/contact"
          class="group text-ink mt-9 inline-flex min-h-12 items-center gap-2 rounded-full bg-white px-6 text-[0.92rem] font-medium transition-all hover:bg-white/90"
          >Nous écrire <ArrowUpRight size={15} /></a
        >
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-24 sm:px-6 lg:px-8 lg:pb-32">
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
      {
        previousGrade ? (
          <a
            href={`/grade/${previousGrade.id}`}
            class="group rounded-[1.75rem] border border-black/[0.06] bg-white p-7 transition-colors hover:bg-[#fbfcfe]"
          >
            <p class="text-ink-mute text-[0.72rem] tracking-[0.18em] uppercase">
              Section précédente
            </p>
            <h3 class="font-display text-ink mt-3 text-[1.5rem] font-medium">
              {previousGrade.title}
            </h3>
            <p class="text-ink-mute mt-2 text-[0.9rem]">
              {previousGrade.grades}
            </p>
            <span class="text-ink group-hover:text-brand mt-5 inline-flex items-center gap-2 text-[0.85rem] font-medium transition-colors">
              Voir la section
              <ArrowRight size={15} />
            </span>
          </a>
        ) : (
          <a
            href="/curriculum"
            class="group rounded-[1.75rem] border border-black/[0.06] bg-white p-7 transition-colors hover:bg-[#fbfcfe]"
          >
            <p class="text-ink-mute text-[0.72rem] tracking-[0.18em] uppercase">
              Vue d'ensemble
            </p>
            <h3 class="font-display text-ink mt-3 text-[1.5rem] font-medium">
              Revoir tout le programme
            </h3>
            <p class="text-ink-mute mt-2 text-[0.9rem]">
              Les trois sections de l'ISAJ, du préscolaire au secondaire.
            </p>
            <span class="text-ink group-hover:text-brand mt-5 inline-flex items-center gap-2 text-[0.85rem] font-medium transition-colors">
              Ouvrir le programme
              <ArrowRight size={15} />
            </span>
          </a>
        )
      }

      {
        nextGrade ? (
          <a
            href={`/grade/${nextGrade.id}`}
            class="group bg-ink rounded-[1.75rem] p-7 text-white transition-colors hover:bg-[var(--color-ink-soft)]"
          >
            <p class="text-[0.72rem] tracking-[0.18em] text-white/45 uppercase">
              Section suivante
            </p>
            <h3 class="font-display mt-3 text-[1.5rem] font-medium text-white">
              {nextGrade.title}
            </h3>
            <p class="mt-2 text-[0.9rem] text-white/60">{nextGrade.subtitle}</p>
            <span class="mt-5 inline-flex items-center gap-2 text-[0.85rem] font-medium text-white">
              Continuer le parcours
              <ArrowRight size={15} />
            </span>
          </a>
        ) : (
          <a
            href="/enrollment"
            class="group bg-ink rounded-[1.75rem] p-7 text-white transition-colors hover:bg-[var(--color-ink-soft)]"
          >
            <p class="text-[0.72rem] tracking-[0.18em] text-white/45 uppercase">
              Prochaine étape
            </p>
            <h3 class="font-display mt-3 text-[1.5rem] font-medium text-white">
              Demander une préinscription
            </h3>
            <p class="mt-2 text-[0.9rem] text-white/60">
              Le secrétariat vous contacte pour vous informer des prochaines
              étapes.
            </p>
            <span class="mt-5 inline-flex items-center gap-2 text-[0.85rem] font-medium text-white">
              Commencer la demande
              <ArrowRight size={15} />
            </span>
          </a>
        )
      }
    </div>
  </section>
</Layout>
