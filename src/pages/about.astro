---
import {
  ArrowLeft,
  ArrowUpRight,
  BookOpen,
  GraduationCap,
  HeartHandshake,
  Landmark,
  ShieldCheck,
  Users,
} from "lucide-react";
import Layout from "../layouts/Layout.astro";
import {
  academicResults,
  community,
  inclusion,
  institutionalFacts,
  institutionalFramework,
  schoolIdentity,
  values,
} from "../data/site-content";

const facts = [
  {
    icon: Landmark,
    label: "Année d'ouverture",
    value: schoolIdentity.openingDate,
  },
  {
    icon: Users,
    label: "Élèves",
    value: `${schoolIdentity.enrollment} élèves`,
  },
  {
    icon: BookOpen,
    label: "Niveaux d'enseignement",
    value: "Préscolaire, fondamental et secondaire",
  },
  {
    icon: GraduationCap,
    label: "Communauté desservie",
    value: schoolIdentity.location,
  },
];
---

<Layout
  title={`À propos — ${schoolIdentity.name} (ISAJ)`}
  description="Histoire, mission, vision, valeurs et cadre institutionnel de l'Institution Le Saint Justien, école privée à Bon-Repos, Croix-des-Bouquets, Haïti."
>
  <section
    class="mx-auto max-w-7xl px-4 pt-12 pb-20 sm:px-6 lg:px-8 lg:pt-16 lg:pb-24"
  >
    <a
      href="/"
      class="group text-ink-mute hover:text-ink inline-flex items-center gap-2 text-[0.85rem] transition-colors"
    >
      <ArrowLeft
        size={15}
        className="transition-transform group-hover:-translate-x-0.5"
      />
      Retour à l'accueil
    </a>
    <div
      class="mt-10 grid grid-cols-1 items-end gap-10 lg:grid-cols-12 lg:gap-16"
    >
      <div class="lg:col-span-8">
        <p
          class="text-ink-mute mb-4 text-[0.72rem] tracking-[0.22em] uppercase"
        >
          Qui sommes-nous ?
        </p>
        <h1
          class="tracking-headline balance text-ink text-[2rem] leading-[1.02] font-semibold sm:text-5xl md:text-[5.5rem]"
        >
          Éduquer aujourd'hui,
          <span class="font-display text-brand-deep font-normal italic"
            >construire l'avenir.</span
          >
        </h1>
      </div>
      <p
        class="pretty text-ink-mute max-w-md text-[1rem] leading-relaxed lg:col-span-4"
      >
        {institutionalFacts.whoWeAre}
      </p>
    </div>
    <div
      class="mt-16 grid grid-cols-1 gap-px overflow-hidden rounded-[2rem] bg-black/[0.06] sm:grid-cols-2 lg:grid-cols-4"
    >
      {
        facts.map((fact) => (
          <div class="bg-white p-7 lg:p-9">
            <fact.icon size={22} className="text-brand" />
            <p class="text-ink-mute mt-8 text-[0.72rem] tracking-[0.18em] uppercase">
              {fact.label}
            </p>
            <p class="font-display text-ink mt-2 text-[1.35rem] leading-snug">
              {fact.value}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8 lg:py-32">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-20">
        <div class="lg:col-span-4">
          <p class="text-ink-mute text-[0.72rem] tracking-[0.22em] uppercase">
            Notre histoire
          </p><h2
            class="tracking-headline text-ink mt-5 text-[1.8rem] leading-[1.05] font-semibold sm:text-4xl"
          >
            Une initiative née d'un besoin de la communauté.
          </h2>
        </div>
        <div class="space-y-6 lg:col-span-8">
          {
            institutionalFacts.history.map((paragraph) => (
              <p class="text-ink-mute max-w-3xl text-[1.05rem] leading-[1.8]">
                {paragraph}
              </p>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8 lg:py-32">
    <div
      class="grid grid-cols-1 gap-px overflow-hidden rounded-[2rem] bg-black/[0.06] md:grid-cols-2"
    >
      <article class="bg-ink p-8 text-white md:p-12">
        <p class="text-[0.72rem] tracking-[0.22em] text-white/45 uppercase">
          Notre mission
        </p>
        <p
          class="font-display mt-8 text-[1.45rem] leading-[1.35] text-white/90 italic md:text-[1.65rem]"
        >
          {institutionalFacts.mission}
        </p>
        <p class="mt-6 text-[0.95rem] leading-relaxed text-white/60">
          {institutionalFacts.missionSecond}
        </p>
      </article>
      <article class="bg-white p-8 md:p-12">
        <p class="text-ink-mute text-[0.72rem] tracking-[0.22em] uppercase">
          Notre vision
        </p>
        <p
          class="font-display text-ink mt-8 text-[1.45rem] leading-[1.35] italic md:text-[1.65rem]"
        >
          {institutionalFacts.vision}
        </p>
        <p class="text-ink-mute mt-6 text-[0.95rem] leading-relaxed">
          {institutionalFacts.approach}
        </p>
      </article>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8 lg:py-32">
      <div class="mb-14 max-w-2xl">
        <p
          class="text-ink-mute mb-4 text-[0.72rem] tracking-[0.22em] uppercase"
        >
          Nos valeurs
        </p><h2
          class="tracking-headline text-ink text-[1.8rem] leading-[1.05] font-semibold sm:text-4xl md:text-[3.25rem]"
        >
          Des repères pour <span
            class="font-display text-brand-deep font-normal italic"
            >grandir ensemble.</span
          >
        </h2>
      </div>
      <ul
        class="grid grid-cols-1 gap-px overflow-hidden rounded-[1.5rem] bg-black/[0.06] sm:grid-cols-2 lg:grid-cols-3"
      >
        {
          values.map((value, index) => (
            <li class="bg-[var(--color-paper)] p-7 lg:p-8">
              <span class="tabular text-ink-mute text-[0.72rem]">
                {String(index + 1).padStart(2, "0")}
              </span>
              <p class="font-display text-ink mt-8 text-[1.2rem] leading-tight">
                {value.title}
              </p>
              <p class="text-ink-mute mt-3 text-[0.9rem] leading-relaxed">
                {value.description}
              </p>
            </li>
          ))
        }
      </ul>

      <div
        class="mt-10 grid grid-cols-1 gap-8 rounded-[1.75rem] border border-black/[0.06] bg-[var(--color-paper)] p-8 md:grid-cols-12 md:p-12"
      >
        <div class="md:col-span-4">
          <HeartHandshake size={22} className="text-brand" />
          <h3
            class="tracking-headline text-ink mt-6 text-[1.5rem] leading-tight font-semibold md:text-[1.9rem]"
          >
            {inclusion.title}
          </h3>
        </div>
        <div class="space-y-4 md:col-span-8">
          {
            inclusion.paragraphs.map((paragraph) => (
              <p class="text-ink-mute text-[1rem] leading-[1.75]">
                {paragraph}
              </p>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8 lg:py-32">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <ShieldCheck size={24} className="text-brand" />
        <p
          class="text-ink-mute mt-6 mb-4 text-[0.72rem] tracking-[0.22em] uppercase"
        >
          Cadre institutionnel
        </p>
        <h2
          class="tracking-headline text-ink text-[1.8rem] leading-[1.05] font-semibold sm:text-4xl md:text-[3rem]"
        >
          Une école inscrite dans le <span
            class="font-display text-brand-deep font-normal italic"
            >système éducatif haïtien.</span
          >
        </h2>
      </div>
      <div class="space-y-6 lg:col-span-7">
        {
          institutionalFramework.paragraphs.map((paragraph) => (
            <p class="text-ink-mute max-w-2xl text-[1.05rem] leading-[1.8]">
              {paragraph}
            </p>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8 lg:py-32">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <p
            class="text-ink-mute mb-4 text-[0.72rem] tracking-[0.22em] uppercase"
          >
            Résultats académiques
          </p>
          <h2
            class="tracking-headline text-ink text-[1.8rem] leading-[1.05] font-semibold sm:text-4xl md:text-[3rem]"
          >
            Préparer les élèves aux <span
              class="font-display text-brand-deep font-normal italic"
              >examens officiels.</span
            >
          </h2>
        </div>
        <div class="space-y-6 lg:col-span-7">
          {
            academicResults.paragraphs.map((paragraph) => (
              <p class="text-ink-mute max-w-2xl text-[1.05rem] leading-[1.8]">
                {paragraph}
              </p>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8 lg:py-32">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <p
          class="text-ink-mute mb-4 text-[0.72rem] tracking-[0.22em] uppercase"
        >
          Notre communauté
        </p>
        <h2
          class="tracking-headline text-ink text-[1.8rem] leading-[1.05] font-semibold sm:text-4xl md:text-[3rem]"
        >
          Une école ancrée à <span
            class="font-display text-brand-deep font-normal italic"
            >Bon-Repos.</span
          >
        </h2>
      </div>
      <div class="space-y-6 lg:col-span-7">
        {
          community.paragraphs.map((paragraph) => (
            <p class="text-ink-mute max-w-2xl text-[1.05rem] leading-[1.8]">
              {paragraph}
            </p>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-24 sm:px-6 lg:px-8 lg:pb-32">
    <div
      class="grid grid-cols-1 gap-8 rounded-[2rem] border border-black/[0.06] bg-white p-8 md:grid-cols-2 md:p-14"
    >
      <div>
        <p
          class="text-ink-mute mb-4 text-[0.72rem] tracking-[0.22em] uppercase"
        >
          Mot de la direction
        </p><h2
          class="tracking-headline text-ink text-3xl leading-[1.08] font-semibold md:text-[3rem]"
        >
          L'éducation au cœur de notre <span
            class="font-display text-brand-deep font-normal italic"
            >action.</span
          >
        </h2>
      </div><blockquote
        class="font-display text-ink text-[1.2rem] leading-[1.55] italic md:text-[1.25rem]"
      >
        «&nbsp;{institutionalFacts.directorMessage}&nbsp;»<footer
          class="text-ink-mute mt-6 font-sans text-[0.78rem] not-italic"
        >
          Osnel Saint-Juste · Directeur Fondateur
        </footer>
      </blockquote>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-24 sm:px-6 lg:px-8 lg:pb-32">
    <div
      class="grain bg-ink relative overflow-hidden rounded-[2.25rem] p-8 text-white md:p-16"
    >
      <p class="text-[0.72rem] tracking-[0.22em] text-white/45 uppercase">
        Partenariats
      </p><h2
        class="tracking-headline mt-4 max-w-3xl text-[1.8rem] leading-[1.05] font-semibold sm:text-4xl md:text-[3.5rem]"
      >
        Construire davantage d'opportunités <span
          class="font-display font-normal text-white/75 italic">ensemble.</span
        >
      </h2><p class="mt-6 max-w-2xl text-[1rem] leading-relaxed text-white/60">
        L'ISAJ souhaite développer des partenariats responsables et durables
        avec des fondations, ONG, établissements scolaires, entreprises,
        associations, organisations communautaires et donateurs.
      </p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <a
          href="/partnership"
          class="group text-ink inline-flex min-h-13 items-center justify-center gap-2 rounded-full bg-white px-7 text-[0.95rem] font-medium transition-all hover:bg-white/90 active:scale-[0.98]"
          >Discuter d'un partenariat <ArrowUpRight
            size={16}
            className="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
          /></a
        >
        <a
          href="/projects"
          class="inline-flex min-h-13 items-center justify-center gap-2 rounded-full border border-white/15 px-6 text-[0.95rem] font-medium text-white transition-colors hover:bg-white/5"
          >Voir nos projets</a
        >
      </div>
    </div>
  </section>
</Layout>
