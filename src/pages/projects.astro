---
import {
  ArrowLeft,
  ArrowUpRight,
  Cpu,
  HeartHandshake,
  Music,
  Scissors,
  Sun,
} from "lucide-react";
import Layout from "../layouts/Layout.astro";
import {
  priorityNeeds,
  projects,
  schoolIdentity,
} from "../data/site-content";

const icons = [Cpu, Sun, Scissors, Music, HeartHandshake];
const items = projects.items.map((item, index) => ({
  ...item,
  icon: icons[index] ?? Cpu,
}));
---

<Layout
  title={`Nos projets — ${schoolIdentity.name} (ISAJ)`}
  description="Les projets en développement de l'ISAJ : laboratoire informatique, énergie solaire, couture, musique et alimentation scolaire, ainsi que ses besoins prioritaires."
>
  <section
    class="mx-auto max-w-7xl px-4 pt-12 pb-20 sm:px-6 lg:px-8 lg:pt-16 lg:pb-24"
  >
    <a
      href="/"
      class="group text-ink-mute hover:text-ink inline-flex items-center gap-2 text-[0.85rem] transition-colors"
    >
      <ArrowLeft
        size={15}
        className="transition-transform group-hover:-translate-x-0.5"
      />
      Retour à l'accueil
    </a>

    <div
      class="mt-10 grid grid-cols-1 items-end gap-10 lg:grid-cols-12 lg:gap-16"
    >
      <div class="lg:col-span-8">
        <p
          class="text-ink-mute mb-4 text-[0.72rem] tracking-[0.22em] uppercase"
        >
          Priorités de développement
        </p>
        <h1
          class="tracking-headline balance text-ink text-[2rem] leading-[1.02] font-semibold sm:text-5xl md:text-[5.5rem]"
        >
          Nos <span class="font-display text-brand-deep font-normal italic"
            >projets.</span
          >
        </h1>
      </div>
      <p
        class="pretty text-ink-mute max-w-md text-[1rem] leading-relaxed lg:col-span-4"
      >
        {projects.intro}
      </p>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8 lg:py-32">
      <div class="space-y-px overflow-hidden rounded-[2rem] bg-black/[0.06]">
        {
          items.map((project, index) => (
            <article class="grid grid-cols-1 gap-6 bg-[var(--color-paper)] p-8 md:grid-cols-12 md:gap-10 md:p-12">
              <div class="md:col-span-5">
                <div class="flex items-center justify-between">
                  <project.icon
                    size={24}
                    strokeWidth={1.6}
                    className="text-brand"
                  />
                  <span class="tabular text-ink-mute text-[0.72rem]">
                    {String(index + 1).padStart(2, "0")} /{" "}
                    {String(items.length).padStart(2, "0")}
                  </span>
                </div>
                <h2 class="tracking-headline text-ink mt-8 text-[1.45rem] leading-tight font-semibold md:text-[2rem]">
                  {project.title}
                </h2>
                <p class="text-brand-deep mt-4 inline-block rounded-full bg-[var(--color-brand-soft)] px-3 py-1 text-[0.7rem] tracking-[0.16em] uppercase">
                  {projects.status}
                </p>
              </div>
              <div class="md:col-span-7">
                <p class="text-ink-mute text-[1rem] leading-[1.8]">
                  {project.description}
                </p>
                <a
                  href={`/soutenir?domaine=${encodeURIComponent(project.supportDomain)}#proposition`}
                  class="group bg-ink hover:bg-ink-soft mt-7 inline-flex min-h-12 items-center gap-2 rounded-full px-6 text-[0.9rem] font-medium text-white transition-all active:scale-[0.98]"
                >
                  Soutenir ce projet
                  <ArrowUpRight
                    size={15}
                    className="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                  />
                </a>
              </div>
            </article>
          ))
        }
      </div>

      <p class="text-ink-mute mt-8 max-w-3xl text-[0.9rem] leading-relaxed">
        Ces initiatives sont présentées comme des projets en développement.
        Elles recherchent actuellement des partenaires et ne sont ni financées
        ni réalisées à ce jour.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8 lg:py-32">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <p
          class="text-ink-mute mb-4 text-[0.72rem] tracking-[0.22em] uppercase"
        >
          Nos besoins prioritaires
        </p>
        <h2
          class="tracking-headline text-ink text-[1.8rem] leading-[1.05] font-semibold sm:text-4xl md:text-[3rem]"
        >
          Ce qui ferait la <span
            class="font-display text-brand-deep font-normal italic"
            >différence.</span
          >
        </h2>
        <p class="text-ink-mute mt-6 max-w-md text-[0.95rem] leading-relaxed">
          Chaque contribution, matérielle ou financière, renforce directement
          les conditions d'apprentissage des élèves de l'ISAJ.
        </p>
      </div>
      <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:col-span-7">
        {
          priorityNeeds.map((need, index) => (
            <li class="flex items-start gap-3 rounded-2xl border border-black/[0.06] bg-white p-5">
              <span class="tabular text-brand-deep text-[0.72rem]">
                {String(index + 1).padStart(2, "0")}
              </span>
              <span class="text-ink text-[0.92rem] leading-relaxed">
                {need}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-24 sm:px-6 lg:px-8 lg:pb-32">
    <div
      class="grain bg-ink relative overflow-hidden rounded-[2.25rem] p-8 text-white md:p-16"
    >
      <div
        class="pointer-events-none absolute -top-32 right-0 h-[40rem] w-[40rem] rounded-full"
        style="background: radial-gradient(circle, rgba(38,87,238,0.22) 0%, transparent 60%)"
      >
      </div>
      <div class="relative max-w-3xl">
        <p class="text-[0.72rem] tracking-[0.22em] text-white/45 uppercase">
          Soutenir l'ISAJ
        </p>
        <h2
          class="tracking-headline balance mt-4 text-[1.8rem] leading-[1.05] font-semibold sm:text-4xl md:text-[3.5rem]"
        >
          Soutenir un projet, <span
            class="font-display font-normal text-white/75 italic"
            >durablement.</span
          >
        </h2>
        <p class="mt-6 max-w-2xl text-[1rem] leading-relaxed text-white/60">
          L'ISAJ recherche des partenaires — fondations, ONG, entreprises,
          associations, établissements scolaires et donateurs — pour développer
          ces initiatives au bénéfice de ses élèves.
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a
            href="/soutenir"
            class="group text-ink inline-flex min-h-13 items-center justify-center gap-2 rounded-full bg-white px-7 text-[0.95rem] font-medium transition-all hover:bg-white/90 active:scale-[0.98]"
            >Soutenir un projet <ArrowUpRight
              size={16}
              className="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
            /></a
          >
          <a
            href="/partnership"
            class="inline-flex min-h-13 items-center justify-center gap-2 rounded-full border border-white/15 px-6 text-[0.95rem] font-medium text-white transition-colors hover:bg-white/5"
            >Devenir partenaire</a
          >
          <a
            href="/contact"
            class="inline-flex min-h-13 items-center justify-center gap-2 px-4 text-[0.95rem] font-medium text-white/85 underline decoration-white/25 decoration-1 underline-offset-[6px] transition-colors hover:text-white hover:decoration-white"
            >Contacter l'ISAJ</a
          >
        </div>
      </div>
    </div>
  </section>
</Layout>
