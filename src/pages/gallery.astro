---
import Layout from "../layouts/Layout.astro";
import GalleryContentPage from "../components/gallery-content-page";
import { galleryPhotos } from "../data/photos";
import { schoolIdentity } from "../data/site-content";

const items = galleryPhotos.map((photo) => ({
  id: photo.src,
  category: photo.category,
  title: photo.title,
  image: photo.src,
  alt: photo.alt,
}));

const videos = [
  {
    id: "fanfare",
    title: "La fanfare de l'ISAJ",
    description: "Répétition de la fanfare de l'établissement.",
    src: "/videos/phanphare.mp4",
    poster: "/isaj-15.jpeg",
  },
  {
    id: "vie-scolaire",
    title: "La vie à l'école",
    description: "Les élèves de l'ISAJ pendant une activité scolaire.",
    src: "/videos/kids.mp4",
    poster: "/kids-1.jpeg",
  },
];
---

<Layout
  title={`Galerie — ${schoolIdentity.name} (ISAJ)`}
  description="Photographies et vidéos de l'Institution Le Saint Justien : l'établissement, la vie en classe, les élèves, l'équipe éducative, les activités scolaires et les cérémonies."
>
  <GalleryContentPage client:load items={items} videos={videos} />
</Layout>
