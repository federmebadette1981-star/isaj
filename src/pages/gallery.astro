---
import Layout from "../layouts/Layout.astro";
import GalleryContentPage from "../components/gallery-content-page";
import { galleryPhotos } from "../data/photos";
import { responsiveImage } from "../lib/images";
import { schoolIdentity } from "../data/site-content";

/**
 * Deux jeux de variantes par photo :
 *  - `thumb` pour la mosaïque (au plus un tiers de la largeur d'écran) ;
 *  - `full` pour la visionneuse plein écran, où la qualité doit tenir à l'agrandissement.
 * Les dimensions d'origine sont transmises telles quelles : sans elles, la
 * mosaïque s'effondre à zéro pixel de haut et le navigateur télécharge toutes
 * les images d'un coup au lieu de respecter `loading="lazy"`.
 */
const items = await Promise.all(
  galleryPhotos.map(async (photo) => ({
    id: photo.key,
    category: photo.category,
    title: photo.title,
    alt: photo.alt,
    thumb: await responsiveImage(photo.image, [400, 800]),
    full: await responsiveImage(photo.image, [1200, 1600]),
  })),
);
---

<Layout
  title={`Galerie — ${schoolIdentity.name} (ISAJ)`}
  description="Découvrez en images la vie de l'Institution Le Saint Justien, son environnement scolaire, ses élèves, son équipe éducative, ses activités et ses initiatives."
>
  <GalleryContentPage client:load items={items} />
</Layout>
