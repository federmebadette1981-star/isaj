---
import { ArrowRight, ArrowUpRight, Globe2 } from "lucide-react";
import Layout from "../layouts/Layout.astro";
import {
  institutionalFacts,
  schoolIdentity,
  teamMembers,
  usRepresentation,
} from "../data/site-content";

const founders = teamMembers.slice(0, 2);
---

<Layout
  title={`Notre équipe — ${schoolIdentity.name} (ISAJ)`}
  description="La direction, l'équipe académique et l'équipe administrative de l'Institution Le Saint Justien, à Bon-Repos, Croix-des-Bouquets."
>
  <section class="mx-auto max-w-7xl px-4 pt-16 pb-12 sm:px-6 lg:px-8 lg:pt-24">
    <div class="grid grid-cols-1 items-end gap-12 lg:grid-cols-12">
      <div class="lg:col-span-8">
        <p
          class="text-ink-mute mb-4 text-[0.72rem] tracking-[0.22em] uppercase"
        >
          Notre équipe
        </p>
        <h1
          class="tracking-headline balance text-ink text-[2rem] leading-[1.02] font-semibold sm:text-5xl md:text-[5.5rem]"
        >
          Les personnes qui font vivre <span
            class="font-display text-brand-deep font-normal italic"
            >l'ISAJ.</span
          >
        </h1>
      </div>
      <p
        class="pretty text-ink-mute max-w-md text-[1rem] leading-relaxed lg:col-span-4"
      >
        Une direction, une équipe académique et une équipe administrative
        engagées auprès des élèves et des familles de Bon-Repos.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
    <div
      class="grid grid-cols-1 gap-px overflow-hidden rounded-[2.25rem] bg-black/[0.06] md:grid-cols-2"
    >
      <article class="bg-ink p-8 text-white md:p-14">
        <p class="text-[0.72rem] tracking-[0.22em] text-white/45 uppercase">
          {founders[0].role}
        </p>
        <h2
          class="tracking-headline mt-5 max-w-3xl text-[1.75rem] leading-[1.05] font-semibold sm:text-4xl md:text-[3.25rem]"
        >
          Osnel <span class="font-display font-normal text-white/75 italic"
            >Saint-Juste.</span
          >
        </h2>
        <p class="mt-6 max-w-xl text-[0.98rem] leading-relaxed text-white/65">
          Fondateur de l'Institution Le Saint Justien, ouverte en septembre
          2011, il dirige l'établissement et porte sa mission éducative au
          service des enfants et des familles de la communauté de Bon-Repos.
        </p>
      </article>
      <article class="bg-white p-8 md:p-14">
        <p class="text-ink-mute text-[0.72rem] tracking-[0.22em] uppercase">
          {founders[1].role}
        </p>
        <h2
          class="tracking-headline text-ink mt-5 max-w-3xl text-[1.75rem] leading-[1.05] font-semibold sm:text-4xl md:text-[3.25rem]"
        >
          Federme <span class="font-display text-brand-deep font-normal italic"
            >Badette.</span
          >
        </h2>
        <p class="text-ink-mute mt-6 max-w-xl text-[0.98rem] leading-relaxed">
          Cofondateur de l'établissement, il a participé à la création de l'ISAJ
          et accompagne aujourd'hui son développement, notamment dans les
          démarches de partenariat et de coopération.
        </p>
      </article>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8 lg:py-32">
      <div class="mb-14 max-w-2xl">
        <p
          class="text-ink-mute mb-4 text-[0.72rem] tracking-[0.22em] uppercase"
        >
          Direction, équipe académique et administration
        </p>
        <h2
          class="tracking-headline balance text-ink text-[1.75rem] leading-[1.05] font-semibold sm:text-4xl md:text-[3.25rem]"
        >
          Une équipe au service <span
            class="font-display text-brand-deep font-normal italic"
            >des élèves.</span
          >
        </h2>
      </div>
      <ul
        class="grid grid-cols-1 gap-px overflow-hidden rounded-[2rem] bg-black/[0.06] sm:grid-cols-2 lg:grid-cols-4"
      >
        {
          teamMembers.map((member, index) => (
            <li class="flex flex-col bg-[var(--color-paper)] p-7 lg:p-8">
              <span class="tabular text-ink-mute text-[0.72rem] font-medium">
                {String(index + 1).padStart(2, "0")}
              </span>
              <h3 class="font-display text-ink mt-10 text-[1.35rem] leading-tight font-medium tracking-[-0.015em]">
                {member.name}
              </h3>
              <p class="text-brand-deep mt-2 text-[0.85rem] leading-relaxed">
                {member.role}
              </p>
            </li>
          ))
        }
      </ul>
      <p class="text-ink-mute mt-6 text-[0.85rem]">
        Ces {teamMembers.length} responsables composent la direction, l'équipe
        académique et l'administration de l'ISAJ, aux côtés de l'équipe
        enseignante.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8 lg:py-32">
    <div
      class="grid grid-cols-1 gap-10 rounded-[2rem] border border-black/[0.06] bg-white p-8 md:grid-cols-12 md:p-14"
    >
      <div class="md:col-span-5">
        <Globe2 size={24} className="text-brand" />
        <p
          class="text-ink-mute mt-6 mb-4 text-[0.72rem] tracking-[0.22em] uppercase"
        >
          À l'international
        </p>
        <h2
          class="tracking-headline text-ink text-[1.6rem] leading-[1.08] font-semibold md:text-[2.25rem]"
        >
          {usRepresentation.title}
        </h2>
      </div>
      <div class="md:col-span-7">
        <ul class="flex flex-wrap gap-2">
          {
            usRepresentation.names.map((name) => (
              <li class="text-ink rounded-full border border-black/[0.08] bg-[var(--color-paper)] px-4 py-2 text-[0.92rem] font-medium">
                {name}
              </li>
            ))
          }
        </ul>
        <p class="text-ink-mute mt-6 text-[1rem] leading-[1.75]">
          {usRepresentation.description}
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-24 sm:px-6 lg:px-8 lg:pb-32">
    <div
      class="grid grid-cols-1 items-center gap-8 rounded-[2rem] border border-black/[0.06] bg-white p-8 md:grid-cols-2 md:p-12"
    >
      <div>
        <p
          class="text-ink-mute mb-4 text-[0.72rem] tracking-[0.22em] uppercase"
        >
          Contact
        </p>
        <h2
          class="tracking-headline text-ink text-3xl leading-[1.1] font-semibold md:text-[2.5rem]"
        >
          Vous souhaitez parler à <span
            class="font-display text-brand-deep font-normal italic"
            >l'équipe</span
          > ?
        </h2>
        <p class="text-ink-mute mt-4 max-w-md text-[0.95rem] leading-relaxed">
          {institutionalFacts.institutionalPromise} Écrivez à l'ISAJ pour toute
          question sur la scolarité, l'admission ou une collaboration.
        </p>
      </div>
      <div class="flex flex-col gap-3 md:items-end">
        <a
          href="/contact"
          class="group bg-ink hover:bg-ink-soft inline-flex min-h-13 items-center justify-center gap-2 rounded-full px-6 text-[0.95rem] font-medium text-white transition-all active:scale-[0.98]"
          >Nous contacter <ArrowUpRight
            size={16}
            className="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
          /></a
        >
        <a
          href="/curriculum"
          class="group text-ink-mute decoration-ink/15 hover:text-ink hover:decoration-ink inline-flex min-h-11 items-center gap-1.5 text-[0.85rem] font-medium underline decoration-1 underline-offset-[6px] transition-colors"
          >Voir le programme <ArrowRight
            size={13}
            className="transition-transform group-hover:translate-x-0.5"
          /></a
        >
      </div>
    </div>
  </section>
</Layout>
