---
import { ArrowLeft, ArrowRight, ArrowUpRight } from "lucide-react";
import Layout from "../layouts/Layout.astro";
import { gradeProfiles } from "../data/grade-profiles";
import { academicResults } from "../data/site-content";

const total = String(gradeProfiles.length).padStart(2, "0");
---

<Layout
  title="Programme scolaire : préscolaire au secondaire | ISAJ"
  description="Le programme de l'ISAJ à Croix-des-Bouquets : section préscolaire, section fondamentale et section secondaire, objectifs pédagogiques et principales matières."
  keywords={[
    "programme scolaire Haïti",
    "préscolaire",
    "fondamental",
    "secondaire",
    "MENFP",
  ]}
  breadcrumbs={[{ name: "Programme", path: "/curriculum" }]}
>
  <section
    class="mx-auto max-w-7xl px-4 pt-12 pb-20 sm:px-6 lg:px-8 lg:pt-16 lg:pb-24"
  >
    <a
      href="/"
      class="group text-ink-mute hover:text-ink inline-flex items-center gap-2 text-[0.85rem] transition-colors"
    >
      <ArrowLeft
        size={15}
        className="transition-transform group-hover:-translate-x-0.5"
      />
      Retour à l'accueil
    </a>

    <div
      class="mt-10 grid grid-cols-1 items-end gap-10 lg:grid-cols-12 lg:gap-16"
    >
      <div class="lg:col-span-8">
        <p
          class="text-ink-mute mb-4 text-[0.72rem] tracking-[0.22em] uppercase"
        >
          Programme scolaire
        </p>
        <h1
          class="tracking-headline balance text-ink text-[2rem] leading-[1.02] font-semibold sm:text-5xl md:text-[5.5rem]"
        >
          Notre programme
          <span class="font-display text-brand-deep font-normal italic"
            >scolaire.</span
          >
        </h1>
      </div>
      <p
        class="pretty text-ink-mute max-w-md text-[1rem] leading-relaxed lg:col-span-4"
      >
        L'ISAJ accompagne les élèves dans les différentes étapes de leur
        parcours scolaire, du préscolaire au secondaire.
      </p>
    </div>

    <div class="mt-16 grid grid-cols-1 gap-12 lg:grid-cols-12">
      <p
        class="text-ink-mute text-[0.72rem] tracking-[0.22em] uppercase lg:col-span-3"
      >
        Sommaire
      </p>
      <ol class="space-y-1 lg:col-span-9">
        {
          gradeProfiles.map((level, idx) => (
            <li>
              <a
                href={`#section-${level.id}`}
                class="group hover:text-brand-deep flex items-baseline justify-between gap-4 border-b border-black/[0.06] py-4 transition-colors"
              >
                <span class="flex items-baseline gap-5">
                  <span class="tabular text-ink-mute text-[0.78rem] font-medium">
                    {String(idx + 1).padStart(2, "0")}
                  </span>
                  <span class="font-display text-ink group-hover:text-brand-deep text-[1.15rem] leading-tight transition-colors">
                    {level.title}
                  </span>
                </span>
                <span class="mx-3 mb-2 hidden flex-1 self-end border-b border-dotted border-black/15 md:block" />
                <span class="text-ink-mute hidden text-[0.8rem] whitespace-nowrap sm:block">
                  {level.grades}
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {
    gradeProfiles.map((level, idx) => (
      <section
        id={`section-${level.id}`}
        class={`scroll-mt-24 ${idx % 2 === 1 ? "bg-white" : ""}`}
      >
        <div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8 lg:py-32">
          <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-16">
            <div class="lg:col-span-4">
              <div class="lg:sticky lg:top-28">
                <p class="tabular text-ink-mute text-[0.78rem] font-medium tracking-[0.18em] uppercase">
                  Section {String(idx + 1).padStart(2, "0")} / {total}
                </p>
                <h2 class="tracking-headline text-ink mt-8 text-[1.75rem] leading-[1.05] font-semibold sm:text-4xl md:text-[3rem]">
                  {level.title}
                </h2>
                <p class="font-display text-ink-soft mt-4 text-[1.2rem] leading-snug italic">
                  {level.subtitle}.
                </p>
                <p class="text-ink-mute mt-6 max-w-md text-[0.95rem] leading-relaxed">
                  {level.overview}
                </p>
                <a
                  href={`/grade/${level.id}`}
                  class="group text-ink decoration-ink/15 hover:text-brand-deep hover:decoration-brand-deep mt-10 inline-flex min-h-11 items-center gap-1.5 text-[0.9rem] font-medium underline decoration-1 underline-offset-[6px] transition-colors"
                >
                  Voir le détail de la section
                  <ArrowUpRight
                    size={14}
                    className="transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
                  />
                </a>
              </div>
            </div>
            <div class="lg:col-span-8">
              <div class="grid grid-cols-1 gap-px overflow-hidden rounded-[1.5rem] bg-black/[0.06] md:grid-cols-3">
                <div class="flex flex-col bg-[var(--color-paper)] p-7 lg:p-8">
                  <span class="tabular text-ink-mute text-[0.72rem] tracking-[0.18em] uppercase">
                    01
                  </span>
                  <h3 class="font-display text-ink mt-8 text-[1.1rem] leading-tight font-medium">
                    Classes concernées
                  </h3>
                  <ul class="mt-5 space-y-3">
                    {level.classes.map((item) => (
                      <li class="text-ink-soft flex items-start gap-2.5 text-[0.88rem] leading-snug">
                        <span class="bg-ink/30 mt-1.5 inline-block h-1 w-1 shrink-0 rounded-full" />
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
                <div class="flex flex-col bg-[var(--color-paper)] p-7 lg:p-8">
                  <span class="tabular text-ink-mute text-[0.72rem] tracking-[0.18em] uppercase">
                    02
                  </span>
                  <h3 class="font-display text-ink mt-8 text-[1.1rem] leading-tight font-medium">
                    Objectifs pédagogiques
                  </h3>
                  <ul class="mt-5 space-y-3">
                    {level.objectives.map((item) => (
                      <li class="text-ink-soft flex items-start gap-2.5 text-[0.88rem] leading-snug">
                        <span class="bg-ink/30 mt-1.5 inline-block h-1 w-1 shrink-0 rounded-full" />
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
                <div class="flex flex-col bg-[var(--color-paper)] p-7 lg:p-8">
                  <span class="tabular text-ink-mute text-[0.72rem] tracking-[0.18em] uppercase">
                    03
                  </span>
                  <h3 class="font-display text-ink mt-8 text-[1.1rem] leading-tight font-medium">
                    Principales matières
                  </h3>
                  <ul class="mt-5 space-y-3">
                    {level.subjects.map((item) => (
                      <li class="text-ink-soft flex items-start gap-2.5 text-[0.88rem] leading-snug">
                        <span class="bg-ink/30 mt-1.5 inline-block h-1 w-1 shrink-0 rounded-full" />
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    ))
  }

  <section class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8 lg:py-32">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <p
          class="text-ink-mute mb-4 text-[0.72rem] tracking-[0.22em] uppercase"
        >
          Résultats académiques
        </p>
        <h2
          class="tracking-headline text-ink text-[1.75rem] leading-[1.05] font-semibold sm:text-4xl md:text-[3rem]"
        >
          Une préparation suivie aux <span
            class="font-display text-brand-deep font-normal italic"
            >examens officiels.</span
          >
        </h2>
      </div>
      <div class="space-y-6 lg:col-span-7">
        {
          academicResults.paragraphs.map((paragraph) => (
            <p class="text-ink-mute max-w-2xl text-[1.05rem] leading-[1.8]">
              {paragraph}
            </p>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-24 sm:px-6 lg:px-8 lg:pb-32">
    <div
      class="grain bg-ink relative overflow-hidden rounded-[2.25rem] p-8 text-white md:rounded-[2.5rem] md:p-16"
    >
      <div
        class="pointer-events-none absolute -top-32 right-0 h-[40rem] w-[40rem] rounded-full"
        style="background: radial-gradient(circle, rgba(38,87,238,0.22) 0%, transparent 60%)"
      >
      </div>
      <div class="relative grid grid-cols-1 items-end gap-10 md:grid-cols-12">
        <div class="md:col-span-7">
          <p class="text-[0.72rem] tracking-[0.22em] text-white/45 uppercase">
            Admissions
          </p>
          <h2
            class="tracking-headline balance mt-4 text-[1.75rem] leading-[1.05] font-semibold sm:text-4xl md:text-[3.5rem]"
          >
            Une question sur une <span
              class="font-display font-normal text-white/75 italic"
              >section</span
            > ?
          </h2>
          <p class="mt-6 max-w-lg text-[0.95rem] leading-relaxed text-white/55">
            Le secrétariat de l'ISAJ informe les familles sur les niveaux, le
            dossier à constituer et les modalités d'inscription.
          </p>
        </div>
        <div class="flex flex-col gap-3 md:col-span-5 md:items-end">
          <a
            href="/contact"
            class="group text-ink inline-flex min-h-13 items-center justify-center gap-2 rounded-full bg-white px-7 text-[0.95rem] font-medium transition-all hover:bg-white/90 active:scale-[0.98]"
            >Nous contacter <ArrowUpRight
              size={16}
              className="transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
            /></a
          >
          <a
            href="/enrollment"
            class="group inline-flex min-h-11 items-center gap-1.5 text-[0.88rem] font-medium text-white/85 underline decoration-white/25 decoration-1 underline-offset-[6px] transition-colors hover:text-white hover:decoration-white"
            >Demande de préinscription <ArrowRight
              size={13}
              className="transition-transform group-hover:translate-x-0.5"
            /></a
          >
        </div>
      </div>
    </div>
  </section>
</Layout>
