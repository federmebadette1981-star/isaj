# Envoi réel des formulaires (Contact et Préinscription).
# Clé gratuite à créer sur https://web3forms.com avec l'adresse e-mail
# officielle de l'ISAJ. Sans cette clé, les formulaires basculent sur le
# logiciel de messagerie du visiteur.
PUBLIC_WEB3FORMS_KEY=

# Alternative : autre service de formulaire (Formspree, etc.).
# Ignoré si PUBLIC_WEB3FORMS_KEY est défini.
PUBLIC_FORM_ENDPOINT=

# Domaine du site — URL canoniques et aperçu des liens (Open Graph).
# À remplacer par le domaine officiel une fois validé par l'administration.
PUBLIC_SITE_URL=https://isaj.vercel.app
