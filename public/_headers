# En-têtes de cache et de sécurité — lus par Cloudflare Pages au déploiement.
# Ce fichier est copié tel quel de public/ vers dist/ : ne pas le déplacer.

# Les fichiers générés par Astro portent un hachage dans leur nom : un contenu
# modifié change de nom. On peut donc les mettre en cache définitivement.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fichiers à nom fixe : cache court, revalidation côté CDN.
/favicon.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/og-isaj.jpg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Le HTML doit toujours être revérifié : c'est lui qui pointe vers les
# nouveaux noms de fichiers hachés après un déploiement.
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
